  "description": "SignalK plugin to influx environment data & Barograph to visualize atmospheric pressure",
  "main": "index.js",
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@influxdata/influxdb-client-apis": "^1.35.0",
