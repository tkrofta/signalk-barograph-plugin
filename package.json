    "axios": "^1.16.1",
    "barometer-trend": "^2.2.7",
    "debug": "^4.4.3",
    "luxon": "^3.7.2"
  },
  "scripts": {
    "debug": "node --inspect-brk=192.168.0.97:9229 /usr/lib/node_modules/signalk-server/bin/signalk-server -c /home/pi/signalk",
