{
  "openapi": "3.0.0",
  "info": {
    "title": "Barograph",
    "version": "1.0.0",
    "description": "Configuration and pressure history for the embedded barograph app. Readable by every logged-in user on Signal K Server 2.31 and later, by administrators only on earlier versions. The InfluxDB credentials stay on the server."
  },
  "servers": [
    {
      "url": "/plugins/signalk-barograph"
    }
  ],
  "paths": {
    "/settings": {
      "get": {
        "summary": "App configuration",
        "description": "Subscribed Signal K paths, history availability and the offered timescales.",
        "responses": {
          "200": {
            "description": "Configuration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Settings" }
              }
            }
          }
        }
      }
    },
    "/history": {
      "get": {
        "summary": "Pressure history",
        "description": "Pressure history from InfluxDB, averaged per resolution window. Up to the write retention the write bucket is used, beyond it the read bucket.",
        "parameters": [
          {
            "name": "hours",
            "in": "query",
            "description": "Timescale in hours (1-72)",
            "schema": { "type": "number", "default": 3, "minimum": 1, "maximum": 72 }
          }
        ],
        "responses": {
          "200": {
            "description": "Pressure history in Pa",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/History" }
              }
            }
          },
          "400": { "description": "Invalid timescale", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "502": { "description": "InfluxDB query failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Plugin stopped or InfluxDB not available", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Settings": {
        "type": "object",
        "properties": {
          "running": { "type": "boolean" },
          "paths": {
            "type": "object",
            "properties": {
              "pressure": { "type": "string", "example": "environment.outside.pressure" },
              "temperature": { "type": "string", "example": "environment.outside.temperature" },
              "altitude": { "type": "string", "example": "navigation.gnss.antennaAltitude" },
              "barometer": { "type": "string", "example": "environment.barometer." }
            }
          },
          "history": {
            "type": "object",
            "properties": {
              "available": { "type": "boolean" },
              "retention": { "type": "number", "description": "write bucket retention in hours" },
              "buckets": {
                "type": "object",
                "description": "InfluxDB buckets the history is read from - write bucket up to the retention, read bucket beyond",
                "properties": {
                  "write": { "type": "string", "example": "signalk" },
                  "read": { "type": "string", "example": "signalk_downsampled" }
                }
              },
              "timescales": { "type": "array", "items": { "type": "number" }, "example": [3, 12, 24, 48, 72] }
            }
          },
          "interval": { "type": "number", "description": "influx write interval in seconds" }
        }
      },
      "History": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "hours": { "type": "number" },
          "resolution": { "type": "number", "description": "window in seconds" },
          "bucket": { "type": "string", "enum": ["write", "read"] },
          "unit": { "type": "string", "example": "Pa" },
          "from": { "type": "string", "format": "date-time" },
          "to": { "type": "string", "format": "date-time" },
          "data": {
            "type": "array",
            "description": "[time in ms, pressure in Pa]",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      }
    }
  }
}
